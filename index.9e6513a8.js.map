"use strict";
var listOfEmployees = document.querySelector("ul");
function sortList(list) {
    var employees = Array.from(list.querySelectorAll("li"));
    employees.sort(function(a, b) {
        return convertSalaryToNumber(b.dataset.salary) - convertSalaryToNumber(a.dataset.salary);
